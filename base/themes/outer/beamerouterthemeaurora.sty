% Aurora outer theme.
%
% Chrome-light: no navigation symbols, no headline / section tree. A slim
% footline carries the short title, short author and the page number, with a
% thin accent rule above it. The frame title is flat, left-aligned and
% accent-coloured with a short accent underline. \logo{...} still works via
% the standard logo slot.

\mode<presentation>

% Fallback so this outer theme is also usable on its own, without the
% Aurora colour theme. \providecolor never overrides an existing definition.
\providecolor{auroraAccent}{HTML}{0F766E}

% No navigation chrome
\setbeamertemplate{navigation symbols}{}
\defbeamertemplate*{headline}{aurora}{}

% Page numbers as "current / total"
\setbeamertemplate{page number in head/foot}[totalframenumber]

% Slim footline with a thin accent rule on top
\defbeamertemplate*{footline}{aurora}
{%
  \leavevmode%
  \hbox{\color{auroraAccent}\vrule width\paperwidth height0.6pt depth0pt}%
  \vskip-0.6pt%
  \hbox{%
    \begin{beamercolorbox}[wd=\paperwidth,ht=2.5ex,dp=1.25ex,leftskip=1.2em,rightskip=1.2em]{footline}%
      \usebeamerfont{footline}%
      \insertshorttitle%
      \hfill%
      \insertshortauthor%
      \hfill%
      \insertlogo\hskip1ex%
      \usebeamercolor[fg]{page number in head/foot}%
      \usebeamerfont{page number in head/foot}%
      \usebeamertemplate{page number in head/foot}%
    \end{beamercolorbox}%
  }%
  \vskip0pt%
}

% Flat, left-aligned, accent frame title with a short accent underline
\defbeamertemplate*{frametitle}{aurora}[1][left]
{%
  \@tempdima=\textwidth%
  \advance\@tempdima by\beamer@leftmargin%
  \advance\@tempdima by\beamer@rightmargin%
  \begin{beamercolorbox}[sep=0.3cm,#1,wd=\the\@tempdima]{frametitle}%
    \usebeamerfont{frametitle}%
    \vbox{}\vskip-1ex%
    \if@tempswa\else\csname beamer@fte#1\endcsname\fi%
    \strut\insertframetitle\strut\par%
    \ifx\insertframesubtitle\@empty%
    \else%
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}%
        \strut\insertframesubtitle\strut\par}%
    \fi%
    \vskip0.35ex%
    {\usebeamercolor[fg]{frametitle}\rule{0.9\textwidth}{1pt}}%
    \vskip-0.55ex%
  \end{beamercolorbox}%
}

% Generous, modern margins
\setbeamersize{text margin left=1.5em,text margin right=1.5em}

\mode
<all>
