% Aurora colour theme.
%
% A modern, flat, corporate palette. The whole beamer colour set is derived
% from a small set of "raw" colours by the shared corporate engine
% (beamercorporatekit). The raws are set with \providecolor, so anything
% defined earlier -- a palette file or a user \definecolor before \usetheme --
% wins. With nothing set, the slate/teal default applies. Aurora uses a single
% accent (brand == accent) on a light surface.

\mode<presentation>

\RequirePackage{beamercorporatekit}

% Raw palette (defaults = slate/teal)
\providecolor{auroraAccent}{HTML}{0F766E}    % brand / accent (teal)
\providecolor{auroraAccentAlt}{HTML}{D97706} % secondary / alert (amber)
\providecolor{auroraInk}{HTML}{1E293B}       % near-black slate text
\providecolor{auroraGray}{HTML}{64748B}      % neutral mid-gray
\providecolor{auroraPaper}{HTML}{FFFFFF}     % slide background

\setcorporatepalette{
  brand=auroraAccent,
  accent=auroraAccent,
  ink=auroraInk,
  gray=auroraGray,
  paper=auroraPaper,
  alert=auroraAccentAlt,
  titlestyle=light
}

\mode
<all>
