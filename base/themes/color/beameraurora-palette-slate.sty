% Aurora palette: slate / teal (the default look).
%
% A palette file simply hard-defines the five raw Aurora colours. It is
% loaded *before* beamercolorthemeaurora.sty (which only \providecolor's
% defaults), so these win. To rebrand with a single colour instead, do not
% pass a palette and just \definecolor{auroraAccent}{...} before \usetheme.

\definecolor{auroraAccent}{HTML}{0F766E}    % brand primary (teal)
\definecolor{auroraAccentAlt}{HTML}{D97706} % secondary / alert (amber)
\definecolor{auroraInk}{HTML}{1E293B}       % near-black slate text
\definecolor{auroraGray}{HTML}{64748B}      % neutral mid-gray
\definecolor{auroraPaper}{HTML}{FFFFFF}     % slide background

\endinput
