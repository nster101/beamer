% Aurora font theme.
%
% A clean modern sans. The actual typeface is loaded by the shared corporate
% engine (beamercorporatekit): Fira Sans (then Lato, then Source Sans Pro) via
% fontspec on XeTeX/LuaTeX, with a graceful fallback to the default sans on
% pdfTeX so the deck always compiles. The typographic *system* below (sizes /
% weights) is engine- and font-independent, so the visual hierarchy -- and the
% regression-test log -- stay stable everywhere; only the typeface differs.

\mode<presentation>

\RequirePackage{beamercorporatekit}

\setcorporatesansfont{
  font=Fira Sans,
  options=Numbers=Lining,
  fallback={Lato,Source Sans Pro}
}

% Engine-independent typographic system
\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{size=\large,series=\mdseries}
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\normalsize,series=\mdseries}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}
\setbeamerfont{part name}{size=\small,series=\bfseries}
\setbeamerfont{part title}{size=\LARGE,series=\bfseries}
\setbeamerfont{section name}{size=\small,series=\bfseries}
\setbeamerfont{section title}{size=\LARGE,series=\bfseries}
\setbeamerfont{block title}{size=\normalsize,series=\bfseries}
\setbeamerfont{itemize/enumerate body}{size=\normalsize}
\setbeamerfont{section in toc}{series=\bfseries}
\setbeamerfont{footline}{size=\scriptsize}

\mode
<all>
