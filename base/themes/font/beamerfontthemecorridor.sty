% Corridor font theme.
%
% Corridor's signature face is Fira Sans (with Fira Mono for code). It is
% loaded via fontspec on XeTeX/LuaTeX, or via the FiraSans/FiraMono LaTeX
% packages on pdfTeX -- but only if those resources are available. If they
% are not, the theme degrades gracefully to the default sans so the deck
% always compiles (including CI, where Fira may be absent). The *typographic
% system* (sizes/weights set through \setbeamerfont) is engine- and
% font-independent, so the visual hierarchy -- and the regression-test log --
% stay stable everywhere; only the actual typeface differs.

\mode<presentation>

\RequirePackage{iftex}

\newif\ifbeamer@corridor@modern
\ifxetex\beamer@corridor@moderntrue\fi
\ifluatex\beamer@corridor@moderntrue\fi

\ifbeamer@corridor@modern
  % Modern engines: prefer real Fira via fontspec; never error if missing.
  \RequirePackage{fontspec}
  \IfFontExistsTF{Fira Sans}
    {\setsansfont{Fira Sans}[Numbers=Lining]}
    {\IfFontExistsTF{FiraSans}{\setsansfont{FiraSans}}{}}%
  \IfFontExistsTF{Fira Mono}
    {\setmonofont{Fira Mono}}
    {\IfFontExistsTF{FiraMono}{\setmonofont{FiraMono}}{}}%
\else
  % pdfTeX: load the FiraSans/FiraMono packages if present, else fall back.
  \IfFileExists{FiraSans.sty}
    {\RequirePackage[sfdefault,lining]{FiraSans}%
     \IfFileExists{FiraMono.sty}{\RequirePackage{FiraMono}}{}%
     \IfFileExists{newtxsf.sty}{\RequirePackage{newtxsf}}{}}
    {}%
\fi

% Modern decks are set in sans; this holds on every engine and font outcome.
\renewcommand*\familydefault{\sfdefault}

% Engine- and font-independent typographic system
\setbeamerfont{title}{size=\fontsize{25}{29}\selectfont,series=\bfseries}
\setbeamerfont{subtitle}{size=\large,series=\mdseries}
\setbeamerfont{frametitle}{size=\LARGE,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\normalsize,series=\mdseries}
\setbeamerfont{kicker}{size=\fontsize{7}{9}\selectfont,series=\bfseries}
\setbeamerfont{author}{size=\normalsize,series=\bfseries}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}
\setbeamerfont{part name}{size=\small,series=\bfseries}
\setbeamerfont{part title}{size=\fontsize{25}{29}\selectfont,series=\bfseries}
\setbeamerfont{section name}{size=\small,series=\bfseries}
\setbeamerfont{section title}{size=\fontsize{25}{29}\selectfont,series=\bfseries}
\setbeamerfont{block title}{size=\normalsize,series=\bfseries}
\setbeamerfont{itemize/enumerate body}{size=\normalsize}
\setbeamerfont{section in toc}{series=\bfseries}
\setbeamerfont{caption}{size=\scriptsize}
\setbeamerfont{footline}{size=\fontsize{5.5}{7}\selectfont}

\mode
<all>
