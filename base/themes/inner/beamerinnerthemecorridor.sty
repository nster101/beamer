%
% Corridor inner theme.
%
% Square teal list markers, spaced bullet environments, a couple of text
% helpers (\quietline, \takeaway), a reusable network motif, and the
% Corridor full-bleed navy title page driven by document metadata. The old
% six-argument \CorridorTitle is kept as a thin compatibility wrapper.

\mode<presentation>

\RequirePackage{etoolbox}
\RequirePackage{tikz}
\usetikzlibrary{calc,arrows.meta,positioning}

% Fallback raws so the inner theme is usable on its own.
\providecolor{corNavy}{HTML}{0C2340}
\providecolor{corTeal}{HTML}{0FA3A3}
\providecolor{corAmber}{HTML}{D98E04}
\providecolor{corRed}{HTML}{B0413E}
\providecolor{corInk}{HTML}{222A33}
\providecolor{corGray}{HTML}{66707A}
\providecolor{corFaint}{HTML}{E7E9E6}
\providecolor{corPaper}{HTML}{FCFCFA}

% ------------------------------------------------------------- markers --
\defbeamertemplate*{itemize item}{Corridor}{%
  {\usebeamercolor{itemize item}\tikz{\fill[fg] (0,0) rectangle (0.62ex,0.62ex);}}}
\defbeamertemplate*{itemize subitem}{Corridor}{%
  {\usebeamercolor{itemize subitem}%
    \tikz{\draw[fg,line width=0.6pt] (0,0) rectangle (0.55ex,0.55ex);}}}
\defbeamertemplate*{itemize subsubitem}{Corridor}{%
  {\usebeamercolor{itemize subsubitem}%
    \tikz{\fill[fg] (0,0) rectangle (0.5ex,0.18ex);}}}

% Spaced itemize environments
\newenvironment{points}{\begin{itemize}\setlength{\itemsep}{0.62em}}{\end{itemize}}
\newenvironment{pointsc}{\begin{itemize}\setlength{\itemsep}{0.38em}}{\end{itemize}}

% Text helpers
% small-caps grey label, used on diagram-heavy frames
\newcommand{\quietline}[1]{{\fontsize{7.5}{10}\selectfont\color{corGray}#1}}
% emphasised takeaway line
\newcommand{\takeaway}[1]{%
  \vspace{0.32em}{\color{corTeal}\rule[0.45ex]{0.55cm}{1.6pt}}\hspace{0.45em}%
  {\bfseries\color{corNavy}#1}}

% ------------------------------------------------------- network motif --
% Reusable decorative node graph, drawn at the current TikZ origin. Callers
% wrap it in a \begin{scope}[shift={...}] to position it. Used by the title
% page here and reused by the section/part divider templates.
\newcommand{\corridornetwork}{%
  \coordinate (cor@a) at (-1.6, 0.55);
  \coordinate (cor@b) at ( 0.1, 1.05);
  \coordinate (cor@c) at ( 1.7, 0.35);
  \coordinate (cor@d) at (-0.6,-0.55);
  \coordinate (cor@e) at ( 1.0,-1.25);
  \coordinate (cor@f) at (-2.3,-1.45);
  \coordinate (cor@g) at ( 2.6,-0.85);
  \coordinate (cor@h) at (-0.2,-2.45);
  \coordinate (cor@i) at (-2.9,-0.25);
  \coordinate (cor@j) at ( 2.1,-2.35);
  \coordinate (cor@k) at (-1.3,-3.35);
  \coordinate (cor@l) at ( 0.9,-3.55);
  \begin{scope}[corTeal,opacity=0.34,line width=0.7pt]
    \draw (cor@a)--(cor@b) (cor@b)--(cor@c) (cor@a)--(cor@d) (cor@b)--(cor@d)
          (cor@d)--(cor@e) (cor@c)--(cor@g) (cor@e)--(cor@g) (cor@d)--(cor@f)
          (cor@f)--(cor@i) (cor@i)--(cor@a) (cor@e)--(cor@h) (cor@f)--(cor@h)
          (cor@h)--(cor@k) (cor@e)--(cor@j) (cor@g)--(cor@j) (cor@j)--(cor@l)
          (cor@h)--(cor@l) (cor@k)--(cor@l);
  \end{scope}
  \foreach \p in {cor@a,cor@b,cor@c,cor@d,cor@f,cor@g,cor@h,cor@i,cor@j,cor@k,cor@l}
    \fill[corTeal,opacity=0.65] (\p) circle (1.7pt);
  \fill[corRed] (cor@e) circle (2.6pt);}

% ---------------------------------------------------------- title page --
% A dedicated eyebrow for the title page (distinct from the per-frame
% \kicker). The \CorridorTitle shim sets it.
\newcommand\corridor@titlekicker{}
\newcommand{\titlekicker}[1]{\renewcommand\corridor@titlekicker{#1}}

% Drive the title page from \title/\subtitle/\author/\institute/\date.
% Recommended use: \begin{frame}[plain]\titlepage\end{frame} so the progress
% bar and footline are suppressed and the navy panel covers the whole slide.
\defbeamertemplate*{title page}{Corridor}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[corNavy] (current page.south west) rectangle (current page.north east);
    \begin{scope}[shift={($(current page.north east)+(-4.0,-2.1)$)}]
      \corridornetwork
    \end{scope}
    % main text block, vertically centred a little above the middle
    \node[anchor=west,text width=0.74\paperwidth,inner sep=0pt]
      at ($(current page.west)+(1.05,0.95)$) {%
        \ifdefempty{\corridor@titlekicker}{}%
          {{\usebeamerfont{kicker}\usebeamercolor[fg]{kicker}%
            \corridor@titlekicker\par}\vspace{0.55em}}%
        {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
        \vspace{0.30em}%
        {\color{corTeal}\rule{1.3cm}{2.4pt}\par}%
        \ifx\insertsubtitle\@empty\else
          \vspace{0.55em}%
          {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}%
            \insertsubtitle\par}%
        \fi};
    % author / institute / date block, bottom-left
    \node[anchor=south west,text width=0.74\paperwidth,inner sep=0pt]
      at ($(current page.south west)+(1.05,1.10)$) {%
        {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}%
        \ifx\insertinstitute\@empty\else
          \vspace{0.18em}%
          {\usebeamerfont{institute}\usebeamercolor[fg]{institute}%
            \insertinstitute\par}%
        \fi
        \vspace{0.18em}%
        {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}};
  \end{tikzpicture}}

% Compatibility shim for the original deck's six-argument title command:
%   \CorridorTitle{kicker}{title line 1}{title line 2}{subtitle}{author}{date}
\newcommand{\CorridorTitle}[6]{%
  \titlekicker{#1}%
  \title[#2 #3]{#2\\#3}%
  \subtitle{#4}%
  \author{#5}%
  \date{#6}%
  \begin{frame}[plain,noframenumbering]
    \titlepage
  \end{frame}}

% ------------------------------------------------- section / part pages --
% Full-bleed navy dividers in the title-page idiom, driven by \section /
% \part. Shown via \sectionpage / \partpage, or automatically by enabling
% \corridorautosection / \corridorautopart (off by default to avoid
% surprising existing decks).
\defbeamertemplate*{section page}{Corridor}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[corNavy] (current page.south west) rectangle (current page.north east);
    \begin{scope}[shift={($(current page.north east)+(-3.4,-1.9)$)},scale=0.82]
      \corridornetwork
    \end{scope}
    \node[anchor=west,text width=0.78\paperwidth,inner sep=0pt]
      at ($(current page.west)+(1.05,0.35)$) {%
        {\usebeamerfont{section name}\usebeamercolor[fg]{section name}%
          \MakeUppercase{\sectionname}\ \insertsectionnumber\par}%
        \vspace{0.40em}%
        {\color{corTeal}\rule{1.3cm}{2.4pt}\par}%
        \vspace{0.50em}%
        {\usebeamerfont{section title}\usebeamercolor[fg]{section title}%
          \insertsectionhead\par}};
  \end{tikzpicture}}

\defbeamertemplate*{part page}{Corridor}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[corNavy] (current page.south west) rectangle (current page.north east);
    \begin{scope}[shift={($(current page.north east)+(-3.4,-1.9)$)},scale=0.82]
      \corridornetwork
    \end{scope}
    \node[anchor=west,text width=0.78\paperwidth,inner sep=0pt]
      at ($(current page.west)+(1.05,0.35)$) {%
        {\usebeamerfont{part name}\usebeamercolor[fg]{part name}%
          \MakeUppercase{\partname}\ \insertromanpartnumber\par}%
        \vspace{0.40em}%
        {\color{corTeal}\rule{1.3cm}{2.4pt}\par}%
        \vspace{0.50em}%
        {\usebeamerfont{part title}\usebeamercolor[fg]{part title}%
          \insertpart\par}};
  \end{tikzpicture}}

% Opt-in automatic dividers
\newcommand{\corridorautosection}{%
  \AtBeginSection[]{\begin{frame}[plain,noframenumbering]\sectionpage\end{frame}}}
\newcommand{\corridorautopart}{%
  \AtBeginPart{\begin{frame}[plain,noframenumbering]\partpage\end{frame}}}

% ----------------------------------------------------- table of contents --
% Teal square marker before each section entry; subsections stay quiet.
\defbeamertemplate*{section in toc}{Corridor}{%
  \leavevmode
  {\usebeamercolor{itemize item}%
    \tikz[baseline=-0.35ex]{\fill[fg] (0,0) rectangle (0.6ex,0.6ex);}}\hspace{0.7em}%
  {\usebeamerfont{section in toc}\usebeamercolor[fg]{section in toc}%
    \inserttocsection}\par}

% Agenda convenience: a frame whose body is the table of contents, with an
% optional frame title (default "Agenda"). For a progress agenda that
% highlights the current section, write a normal frame with
% \tableofcontents[currentsection] instead.
\newcommand{\corridoragenda}[1][Agenda]{%
  \begin{frame}{#1}\tableofcontents\end{frame}}

% ------------------------------------------------------ data / metrics --
% Reusable business components: cards, KPI tiles, a big-number stat frame and
% comparison columns. The row environments space their children evenly by
% emitting \hfill glue, so no manual \hfill is needed between items.

% \corridorcard[width]{title}{body}{tag}
\newcommand{\corridorcard}[4][0.30\textwidth]{%
  \begin{minipage}[t]{#1}
    \raggedright\hyphenpenalty=10000\exhyphenpenalty=10000\relax
    {\color{corTeal}\rule{\linewidth}{2.4pt}}\par\vspace{4.5pt}
    {\fontsize{10.5}{12.5}\selectfont\bfseries\color{corNavy}#2\par}\vspace{4pt}
    {\fontsize{8.2}{10.8}\selectfont\color{corInk}#3\par}\vspace{5pt}
    {\fontsize{7.2}{9}\selectfont\bfseries #4\par}
  \end{minipage}\hfill}
\newenvironment{corridorcards}
  {\par\medskip\noindent\hfill\ignorespaces}{\unskip\par\medskip}

% \corridorkpi{value}{label}{delta}  (delta may be empty; embed \color for sign)
\newcommand{\corridorkpi}[3]{%
  \begin{minipage}[t]{0.22\textwidth}\centering
    {\fontsize{26}{30}\selectfont\bfseries\color{corNavy}#1\par}\vspace{2pt}
    {\fontsize{8}{10}\selectfont\color{corGray}#2\par}%
    \ifblank{#3}{}{\vspace{2pt}{\fontsize{8.5}{10}\selectfont\bfseries
      \color{corTeal}#3\par}}%
  \end{minipage}\hfill}
\newenvironment{corridorkpis}
  {\par\medskip\noindent\hfill\ignorespaces}{\unskip\par\medskip}

% Big-number stat frame: \corridorstat{number}{caption}
\newcommand{\corridorstat}[2]{%
  \begin{frame}
    \vfill
    \begin{center}
      {\fontsize{58}{64}\selectfont\bfseries\color{corTeal}#1\par}
      \vspace{0.45em}
      {\usebeamerfont{frametitle}\color{corNavy}#2\par}
    \end{center}
    \vfill
  \end{frame}}

% Comparison columns: corridorcompare environment + \corridorcompcol.
% \corridorcompcol[width]{header}{body}; starred variant tints the column
% as the recommended/highlighted option.
\newenvironment{corridorcompare}{\begin{columns}[T]}{\end{columns}}
\newcommand{\corridorcompcol}[3][0.46\textwidth]{%
  \begin{column}{#1}
    {\color{corTeal}\rule{\linewidth}{2.4pt}}\par\vspace{4pt}
    {\fontsize{11}{13}\selectfont\bfseries\color{corNavy}#2\par}\vspace{5pt}
    {\fontsize{9}{12}\selectfont\color{corInk}#3\par}
  \end{column}}
\newcommand{\corridorcompcolhot}[3][0.46\textwidth]{%
  \begin{column}{#1}
    \colorbox{corTeal!10}{\begin{minipage}[t]{\dimexpr#1-2\fboxsep\relax}
      {\color{corTeal}\rule{\linewidth}{2.4pt}}\par\vspace{4pt}
      {\fontsize{11}{13}\selectfont\bfseries\color{corNavy}#2\par}\vspace{5pt}
      {\fontsize{9}{12}\selectfont\color{corInk}#3\par}
    \end{minipage}}%
  \end{column}}

% ----------------------------------------------------------- narrative --
% Emphasis slides: a full-bleed quote frame, a big-statement frame, an inline
% callout box and a two-up emphasis layout.

% \corridorquote{quote}{attribution} -- full-bleed navy quote frame
\newcommand{\corridorquote}[2]{%
  \begin{frame}[plain,noframenumbering]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[corNavy] (current page.south west) rectangle (current page.north east);
      \node[anchor=west,text width=0.80\paperwidth,inner sep=0pt]
        at ($(current page.west)+(1.05,0.45)$) {%
          {\color{corTeal}\fontsize{34}{34}\selectfont\bfseries``\par}%
          \vspace{-0.2em}%
          {\usebeamerfont{frametitle}\color{corPaper}#1\par}%
          \vspace{0.7em}%
          {\color{corTeal}\rule[0.28ex]{1.0cm}{2pt}}\hspace{0.45em}%
          {\fontsize{9}{12}\selectfont\color{corFaint}#2}};
    \end{tikzpicture}
  \end{frame}}

% \corridorstatement{text} -- big thesis statement on paper
\newcommand{\corridorstatement}[1]{%
  \begin{frame}
    \vfill
    {\color{corTeal}\rule{1.3cm}{2.4pt}}\par\vspace{0.5em}
    {\fontsize{22}{27}\selectfont\bfseries\color{corNavy}#1\par}
    \vfill
  \end{frame}}

% \corridorcallout[kind]{text} -- inline tinted callout with accent left rule.
% kind = note (teal, default) | warn (amber) | risk (red)
\newcommand{\corridorcallout}[2][note]{%
  \def\corridor@coclr{corTeal}%
  \ifstrequal{#1}{warn}{\def\corridor@coclr{corAmber}}{}%
  \ifstrequal{#1}{risk}{\def\corridor@coclr{corRed}}{}%
  \par\medskip\noindent
  \begin{tikzpicture}
    \node[inner sep=8pt,text width=\dimexpr\linewidth-22pt\relax,align=left,
          fill=\corridor@coclr!10,text=corInk] (corridor@co) {#2};
    \draw[\corridor@coclr,line width=2.6pt]
      (corridor@co.north west) -- (corridor@co.south west);
  \end{tikzpicture}\par\medskip}

% \corridortwoup{left header}{left body}{right header}{right body}
\newcommand{\corridortwoup}[4]{%
  \begin{columns}[T]
    \begin{column}{0.46\textwidth}
      {\color{corTeal}\rule{\linewidth}{2.4pt}}\par\vspace{4pt}
      {\fontsize{11}{13}\selectfont\bfseries\color{corNavy}#1\par}\vspace{5pt}
      {\fontsize{9}{12}\selectfont\color{corInk}#2\par}
    \end{column}\hfill
    \begin{column}{0.46\textwidth}
      {\color{corTeal}\rule{\linewidth}{2.4pt}}\par\vspace{4pt}
      {\fontsize{11}{13}\selectfont\bfseries\color{corNavy}#3\par}\vspace{5pt}
      {\fontsize{9}{12}\selectfont\color{corInk}#4\par}
    \end{column}
  \end{columns}}

\mode
<all>
